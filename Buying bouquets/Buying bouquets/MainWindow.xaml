<Window x:Class="Buying_bouquets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buying_bouquets"
        mc:Ignorable="d"
       Title="Авторизация" Height="450" Width="350"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" Text="Вход в систему" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Text="Логин:"/>
        <TextBox x:Name="LoginBox" Margin="0,2,0,10"/>

        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10"/>

        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="FullNameBox" Margin="0,2,0,10"/>

            <TextBlock Text="Телефон (+7 XXX XXX-XX-XX):"/>
            <TextBox x:Name="PhoneBox" Margin="0,2,0,10"/>

            <TextBlock Text="Адрес (ул. ..., д. ..., кв. ...):"/>
            <TextBox x:Name="AddressBox" Margin="0,2,0,5"/>

            <CheckBox x:Name="NoApartmentCheck" Content="Нет квартиры (частный дом)" Margin="0,0,0,10"/>
        </StackPanel>

        <Button x:Name="ActionButton" Content="Войти" Click="ActionButton_Click" Height="30" Margin="0,5,0,10"/>

        <Button x:Name="SwitchModeButton" Content="Зарегистрироваться" Click="SwitchModeButton_Click"/>
    </StackPanel>
</Window>