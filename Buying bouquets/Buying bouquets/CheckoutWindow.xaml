<Window x:Class="Buying_bouquets.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="360" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Данные получателя" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Text="ФИО:"/>
        <TextBox x:Name="FullNameBox" Margin="0,2,0,10"/>

        <TextBlock Text="Телефон (+7 XXX XXX-XX-XX):"/>
        <TextBox x:Name="PhoneBox" Margin="0,2,0,10"/>

        <TextBlock Text="Адрес доставки:"/>
        <TextBox x:Name="AddressBox" Margin="0,2,0,5"/>

        <CheckBox x:Name="NoApartmentCheck" Content="Нет квартиры (частный дом)" Margin="0,0,0,15"/>

        <TextBlock x:Name="SummaryText" FontWeight="Bold" Margin="0,0,0,15"/>

        <Button Content="Подтвердить заказ" Click="ConfirmButton_Click" Height="30"/>
    </StackPanel>
</Window>