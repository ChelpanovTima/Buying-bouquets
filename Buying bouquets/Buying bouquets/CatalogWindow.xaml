<Window x:Class="Buying_bouquets.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог букетов и корзина" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Каталог  " FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="CatalogListBox" MouseDoubleClick="CatalogListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Border Width="60" Height="60" Background="#FFE8F5E9" BorderBrush="#FF81C784" BorderThickness="1">
                                <TextBlock Text="Фото" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} руб.'}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock x:Name="UserInfoText" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Убрать 1 шт" Click="RemoveButton_Click" Height="28" Margin="0,0,0,8"/>
                <TextBlock x:Name="TotalTextBlock" Text="Итого: 0,00 руб." FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <Button Content="Оформить заказ" Click="CheckoutButton_Click" Height="32"/>
            </StackPanel>

            <DataGrid x:Name="CartDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Букет" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="75"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="55"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>